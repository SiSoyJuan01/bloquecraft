        els.healthBar.appendChild(span);
      }

      els.hungerBar.innerHTML = '';
      const drums = Math.ceil(player.hunger / 2);
      for (let i = 0; i < 10; i++) {
        const span = document.createElement('span');
        span.className = 'text-xs sm:text-sm leading-none';
        span.textContent = i < drums ? '🍗' : '🦴';
        span.style.opacity = i < drums ? '1' : '0.4';
