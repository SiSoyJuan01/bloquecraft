    // ===== Sonido sintetizado (WebAudio, sin archivos ni servicios) =====
    const Sfx = (() => {
      let ctx = null, on = true;
      const c = () => { if (!ctx) { try { ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch { return null; } } if (ctx.state === 'suspended') ctx.resume(); return ctx; };
      function tone(f0, f1, dur, type, vol) {
        const a = c(); if (!a || !on) return; const t = a.currentTime, o = a.createOscillator(), g = a.createGain();
        o.type = type; o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(30, f1), t + dur);
        g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        o.connect(g); g.connect(a.destination); o.start(t); o.stop(t + dur);
      }
      function noise(dur, vol, freq) {
        const a = c(); if (!a || !on) return; const n = Math.floor(a.sampleRate * dur), b = a.createBuffer(1, n, a.sampleRate), d = b.getChannelData(0);
        for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
        const src = a.createBufferSource(), f = a.createBiquadFilter(), g = a.createGain();
        src.buffer = b; f.type = 'bandpass'; f.frequency.value = freq; g.gain.value = vol; src.connect(f); f.connect(g); g.connect(a.destination); src.start();
      }
      return {
        play(n) {
          if (n === 'break') { noise(0.14, 0.5, 900); tone(140, 60, 0.1, 'square', 0.12); }
          else if (n === 'place') { tone(240, 130, 0.08, 'triangle', 0.25); noise(0.05, 0.2, 1800); }
          else if (n === 'hurt') tone(320, 70, 0.25, 'sawtooth', 0.22);
          else if (n === 'pickup') tone(620, 1250, 0.1, 'sine', 0.2);
        },
        toggle() { on = !on; return on; }
      };
    })();

    // ===== Rendimiento adaptativo =====
    let _lowFpsCount = 0;
    function adaptPerf(fps) {
      if (appState.screen !== 'playing') return;
      if (IS_MOBILE && !window._mobInit) {
        window._mobInit = true;
        if (graphicsSettings.renderDistance > 3) graphicsSettings.renderDistance = 3;
        graphicsSettings.shadows = false; applyGraphicsSettings();
      }
      _lowFpsCount = fps < 24 ? _lowFpsCount + 1 : 0;
      if (_lowFpsCount >= 6) {
        _lowFpsCount = 0;
        if (graphicsSettings.shadows) { graphicsSettings.shadows = false; applyGraphicsSettings(); showToast('Rendimiento bajo: sombras desactivadas'); }
        else if (graphicsSettings.renderDistance > 2) { graphicsSettings.renderDistance--; applyGraphicsSettings(); showToast('Rendimiento bajo: distancia ' + graphicsSettings.renderDistance + ' chunks'); }
      }
    }

    function animateLoop(now) {
      animFrameId = requestAnimationFrame(animateLoop);

      const rawDt = (now - lastFrameTime) / 1000;
      lastFrameTime = now;
      const dt = Math.min(0.05, Math.max(0.001, rawDt));

      fpsAccumulator += rawDt;
      fpsFrames++;
      if (fpsAccumulator >= 0.5) {
        currentFps = Math.round(fpsFrames / fpsAccumulator);
        adaptPerf(currentFps);
        fpsAccumulator = 0;
        fpsFrames = 0;
      }

      if (appState.screen === 'playing' && voxelWorld && !isAnyModalOpen()) {
        updatePlayerPhysics(dt);
        updateSkyAndLighting(dt);
        voxelWorld.updateStreaming(player.pos, 2);

        if (cloudGroup) {
          cloudGroup.position.x = ((now * 0.004) % 240) - 120;
        }

        if (heldItemMesh && heldItemMesh.visible) {
          const moving = (keys['KeyW'] || keys['KeyA'] || keys['KeyS'] || keys['KeyD'] || touchKeys['w'] || touchKeys['a'] || touchKeys['s'] || touchKeys['d']);
          const t = now * 0.008;
          const bobY = moving && !player.flying ? Math.sin(t * 2.2) * 0.02 : 0;
          const bobX = moving && !player.flying ? Math.cos(t * 1.1) * 0.013 : 0;
          if (isMiningHeld && swingAnim < 1) swingAnim = Math.min(1, swingAnim + dt * 5);
          if (!isMiningHeld) swingAnim = Math.max(0, swingAnim - dt * 6);
          const swing = Math.sin(swingAnim * Math.PI) * 0.55;
          const base = new THREE.Vector3(0.42 + bobX, -0.4 + bobY - swing * 0.12, -0.72 - swing * 0.08);
          heldItemMesh.position.copy(base.applyQuaternion(camera.quaternion).add(camera.position));
          heldItemMesh.quaternion.copy(camera.quaternion);
          heldItemMesh.rotateZ(-0.12);
          heldItemMesh.rotateX(-swing * 0.9);
        }

        const { hitBlock } = raycastBlocksAndMobs();
        if (hitBlock && !appState.isDead) {
          blockHighlight.position.set(hitBlock.x + 0.5, hitBlock.y + 0.5, hitBlock.z + 0.5);
          blockHighlight.visible = true;
          const bName = ITEM_DEFS[hitBlock.blockId]?.name || 'Block';
          els.targetLabel.textContent = bName;
          els.targetLabel.style.opacity = '1';
        } else {
          blockHighlight.visible = false;
          els.targetLabel.style.opacity = '0';
        }

        if (isMiningHeld) {
          handlePrimaryAction(dt, false);
        }

        if (particles) {
          particles.update(dt);
        }

        if (pickups) {
          pickups.update(dt, player.pos, (itemId, count) => {
            addItemToInventory(itemId, count);
            Sfx.play("pickup");
            showToast(`+${count} ${ITEM_DEFS[itemId]?.name || 'Item'}`);
          });
        }

        if (creatures) {
          creatures.update(dt, player.pos, appState.activeWorld.mode, isNightTime(), (dmg, src) => {
            hurtPlayer(dmg, src);
          });
        }

        els.hudTelemetry.textContent = `Biome: ${voxelWorld.lastBiome} • ${getClockLabel()} • FPS: ${currentFps}`;
        els.hudCoords.textContent = `XYZ: ${player.pos.x.toFixed(1)}, ${player.pos.y.toFixed(1)}, ${player.pos.z.toFixed(1)}`;

        autoSaveTimer += dt;
        if (autoSaveTimer >= 15) {
          autoSaveTimer = 0;
          saveCurrentWorldState(false);
        }
      } else if (appState.screen === 'main' || appState.screen === 'worlds') {
        timeOfDay = (timeOfDay + dt * 0.004) % 1;
        updateSkyAndLighting(dt);
        camera.position.set(Math.sin(now * 0.00012) * 18, 28, Math.cos(now * 0.00012) * 18);
        camera.lookAt(0, 14, 0);
        if (cloudGroup) {
          cloudGroup.position.x = ((now * 0.004) % 240) - 120;
        }
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    // ============================================================================
    // 15. BOOTSTRAP ENTRY POINT
    // ============================================================================
    window.addEventListener('DOMContentLoaded', () => {
      ensureThreeLoaded(async () => {
        try {
          const backend = await storage.init();
          els.storageBadge.textContent = `Persistence Active: ${backend} + localStorage fallback`;
          initThreeEngine();
          bindEvents();
          await refreshWorldManagerUI();
          setScreen('main');
          lastFrameTime = performance.now();
          animFrameId = requestAnimationFrame(animateLoop);
        } catch (err) {
          console.error('Initialization error:', err);
          showToast('Error starting BLOQUECRAFT BETA 1.0', 6000);
        }
      });
    });
  })();
  </script>
</body>
</html>
