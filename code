    function canCraft(recipe) {
      if (appState.activeWorld?.mode === 'creative') return true;
      return recipe.ingredients.every((ing) => (player.inventory[ing.id] || 0) >= ing.count);
    }

    function craftRecipe(recipe) {
      if (!canCraft(recipe)) {
        showToast('Missing required ingredients');
        return;
      }
      if (appState.activeWorld?.mode !== 'creative') {
        for (const ing of recipe.ingredients) {
          consumeItemFromInventory(ing.id, ing.count);
        }
      }
      addItemToInventory(recipe.output.id, recipe.output.count);
      showToast(`Crafted ${recipe.name}`);
      renderInventoryAndCrafting();
    }

    function renderInventoryAndCrafting() {
