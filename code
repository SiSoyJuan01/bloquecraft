    class CreatureManager {
      constructor(scene, world, pickups) {
        this.scene = scene;
        this.world = world;
        this.pickups = pickups;
        this.mobs = [];
        this.spawnTimer = 0;
      }

      createMobMesh(spec) {
        const root = new THREE.Group();
        const bodyMat = new THREE.MeshLambertMaterial({ color: spec.bodyColor });
        const headMat = new THREE.MeshLambertMaterial({ color: spec.accentColor });
        const legMat = new THREE.MeshLambertMaterial({ color: spec.legColor });

        if (spec.type === 'zombie' || spec.type === 'skeleton') {
          const torso = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.65, 0.26), bodyMat);
          torso.position.y = 0.95;
          torso.castShadow = true;
          root.add(torso);

          const head = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.42, 0.42), headMat);
          head.position.y = 1.5;
          head.castShadow = true;
          root.add(head);

          const eyeMat = new THREE.MeshBasicMaterial({ color: spec.hostile ? 0xef4444 : 0x0f172a });
          const eyeL = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.07, 0.04), eyeMat);
          eyeL.position.set(-0.1, 1.52, 0.22);
          const eyeR = eyeL.clone();
          eyeR.position.x = 0.1;
          root.add(eyeL, eyeR);

          const armL = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.58, 0.16), headMat);
          armL.position.set(-0.33, 0.98, 0.18);
          armL.rotation.x = -Math.PI * 0.35;
          const armR = armL.clone();
          armR.position.x = 0.33;
          root.add(armL, armR);

          const legL = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.62, 0.18), legMat);
          legL.position.set(-0.13, 0.31, 0);
          const legR = legL.clone();
          legR.position.x = 0.13;
          root.add(legL, legR);

          root.userData = { legL, legR, armL, armR, isBiped: true };
        } else {
          const isBird = spec.type === 'chicken';
          const bodyW = isBird ? 0.36 : 0.52;
          const bodyH = isBird ? 0.34 : 0.46;
          const bodyD = isBird ? 0.42 : 0.72;
          const bodyY = isBird ? 0.38 : 0.54;

          const body = new THREE.Mesh(new THREE.BoxGeometry(bodyW, bodyH, bodyD), bodyMat);
          body.position.y = bodyY;
          body.castShadow = true;
          root.add(body);

          const headSize = isBird ? 0.26 : 0.38;
          const head = new THREE.Mesh(new THREE.BoxGeometry(headSize, headSize, headSize), headMat);
          head.position.set(0, bodyY + bodyH * 0.42, bodyD * 0.5 + headSize * 0.3);
          head.castShadow = true;
          root.add(head);

          const legH = isBird ? 0.22 : 0.32;
          const legW = isBird ? 0.07 : 0.14;
          const legOffsets = [
            [-bodyW * 0.3, legH * 0.5, bodyD * 0.3],
            [bodyW * 0.3, legH * 0.5, bodyD * 0.3],
            [-bodyW * 0.3, legH * 0.5, -bodyD * 0.3],
            [bodyW * 0.3, legH * 0.5, -bodyD * 0.3]
          ];
          const legs = legOffsets.map(([lx, ly, lz]) => {
            const leg = new THREE.Mesh(new THREE.BoxGeometry(legW, legH, legW), legMat);
            leg.position.set(lx, ly, lz);
            leg.castShadow = true;
            root.add(leg);
            return leg;
          });

          root.userData = { legs, isBiped: false };
        }

        return root;
      }

      spawnMob(typeKey, pos) {
        const spec = CREATURE_SPECS[typeKey];
        if (!spec || this.mobs.length >= 26) return;
        const mesh = this.createMobMesh(spec);
        mesh.position.copy(pos);
        this.scene.add(mesh);

        this.mobs.push({
          spec,
          mesh,
          hp: spec.maxHp,
          velY: 0,
          yaw: Math.random() * Math.PI * 2,
          aiTimer: Math.random() * 2,
          walkPhase: Math.random() * Math.PI * 2,
          attackCooldown: 0,
          hurtTimer: 0
        });
      }

      populateInitial(playerPos, isNight) {
        const types = isNight
          ? ['zombie', 'skeleton', 'cow', 'sheep', 'pig', 'chicken']
          : ['cow', 'sheep', 'pig', 'chicken', 'cow', 'sheep'];
        for (let i = 0; i < 10; i++) {
          const angle = (i / 10) * Math.PI * 2 + 0.4;
          const dist = 10 + (i % 4) * 5;
          const x = playerPos.x + Math.cos(angle) * dist;
          const z = playerPos.z + Math.sin(angle) * dist;
          const y = this.world.findSafeSpawnY(x, z);
          this.spawnMob(types[i % types.length], new THREE.Vector3(x, y, z));
        }
      }

      update(dt, playerPos, gameMode, isNight, onPlayerHurt) {
        this.spawnTimer += dt;
        if (this.spawnTimer > 5.5) {
          this.spawnTimer = 0;
          if (this.mobs.length < 24) {
            const angle = Math.random() * Math.PI * 2;
            const dist = 14 + Math.random() * 14;
            const sx = playerPos.x + Math.cos(angle) * dist;
            const sz = playerPos.z + Math.sin(angle) * dist;
            const sy = this.world.findSafeSpawnY(sx, sz);

            let pool = ['cow', 'sheep', 'pig', 'chicken'];
            if (isNight) {
              pool = ['zombie', 'skeleton', 'zombie', 'cow', 'sheep'];
            }
            const pick = pool[Math.floor(Math.random() * pool.length)];
            this.spawnMob(pick, new THREE.Vector3(sx, sy, sz));
          }
        }

        for (let i = this.mobs.length - 1; i >= 0; i--) {
          const mob = this.mobs[i];
          const pos = mob.mesh.position;

          const dxPlayer = playerPos.x - pos.x;
          const dzPlayer = playerPos.z - pos.z;
          const horizDist = Math.hypot(dxPlayer, dzPlayer);
          if (horizDist > 68) {
            this._removeMobAt(i);
            continue;
          }

          if (mob.attackCooldown > 0) mob.attackCooldown -= dt;
          if (mob.hurtTimer > 0) {
            mob.hurtTimer -= dt;
            mob.mesh.scale.setScalar(1 + Math.sin(mob.hurtTimer * 25) * 0.08);
          } else {
            mob.mesh.scale.setScalar(1);
          }

          mob.aiTimer -= dt;
          let moveSpeed = 0;
          const shouldChase = mob.spec.hostile && gameMode === 'survival' && horizDist < 16;

          if (shouldChase) {
            mob.yaw = Math.atan2(dxPlayer, dzPlayer);
            moveSpeed = mob.spec.speed;
          } else if (mob.aiTimer <= 0) {
            mob.aiTimer = 1.4 + Math.random() * 2.5;
            if (Math.random() < 0.65) {
              mob.yaw += (Math.random() - 0.5) * 2.2;
              moveSpeed = mob.spec.speed * 0.65;
            } else {
              moveSpeed = 0;
            }
          } else if (mob.walkPhase > 0.01) {
            moveSpeed = mob.spec.speed * 0.55;
          }

          if (moveSpeed > 0) {
            const mx = Math.sin(mob.yaw) * moveSpeed * dt;
            const mz = Math.cos(mob.yaw) * moveSpeed * dt;
            const testX = pos.x + mx;
            const testZ = pos.z + mz;

            const blockAhead = this.world.getBlock(testX, pos.y + 0.1, testZ);
            const blockAboveAhead = this.world.getBlock(testX, pos.y + 1.1, testZ);

            if (!ITEM_DEFS[blockAhead]?.solid) {
              pos.x = testX;
              pos.z = testZ;
            } else if (!ITEM_DEFS[blockAboveAhead]?.solid && mob.velY <= 0.05) {
              mob.velY = 6.2;
              pos.x = testX * 0.6 + pos.x * 0.4;
              pos.z = testZ * 0.6 + pos.z * 0.4;
            } else {
              mob.yaw += Math.PI * 0.65;
            }
            mob.walkPhase += dt * 9;
          } else {
            mob.walkPhase = 0;
          }

          mob.velY -= 18 * dt;
          const nextY = pos.y + mob.velY * dt;
          const groundBlock = this.world.getBlock(pos.x, nextY - 0.05, pos.z);
          if (ITEM_DEFS[groundBlock]?.solid && mob.velY <= 0) {
            pos.y = Math.floor(nextY - 0.05) + 1.0;
            mob.velY = 0;
          } else {
            pos.y = Math.max(2, nextY);
          }

          mob.mesh.rotation.y = mob.yaw;

          const swing = Math.sin(mob.walkPhase) * (moveSpeed > 0 ? 0.55 : 0);
          if (mob.mesh.userData.isBiped) {
            mob.mesh.userData.legL.rotation.x = swing;
            mob.mesh.userData.legR.rotation.x = -swing;
          } else if (mob.mesh.userData.legs) {
            const [fl, fr, bl, br] = mob.mesh.userData.legs;
            fl.rotation.x = swing;
            fr.rotation.x = -swing;
            bl.rotation.x = -swing;
            br.rotation.x = swing;
          }

          if (shouldChase && horizDist < 1.55 && Math.abs(playerPos.y - pos.y) < 1.8 && mob.attackCooldown <= 0) {
            mob.attackCooldown = 1.25;
            onPlayerHurt(mob.spec.damage, mob.spec.label);
          }
        }
      }

      damageMob(mob, amount, knockDir) {
        mob.hp -= amount;
        mob.hurtTimer = 0.25;
        if (knockDir) {
          mob.mesh.position.x += knockDir.x * 0.45;
          mob.mesh.position.z += knockDir.z * 0.45;
          mob.velY = 4.2;
        }
        if (mob.hp <= 0) {
          const idx = this.mobs.indexOf(mob);
          if (idx !== -1) {
            const dropPos = mob.mesh.position.clone().add(new THREE.Vector3(0, 0.5, 0));
            this.pickups.spawn(mob.spec.dropItem, mob.spec.dropCount, dropPos);
            this._removeMobAt(idx);
          }
          return true;
        }
        return false;
      }

      _removeMobAt(idx) {
        const mob = this.mobs[idx];
        this.scene.remove(mob.mesh);
        mob.mesh.traverse((obj) => {
          if (obj.geometry) obj.geometry.dispose();
          if (obj.material) obj.material.dispose();
        });
        this.mobs.splice(idx, 1);
      }

      clear() {
        for (let i = this.mobs.length - 1; i >= 0; i--) {
          this._removeMobAt(i);
        }
      }
    }

