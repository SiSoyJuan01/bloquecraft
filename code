    function updateHeldItem() {
      if (!heldItemMesh) return;
      const id = getSelectedHotbarItemId();
      if (!id || !ITEM_DEFS[id]) {
        heldItemMesh.visible = false;
        showHeldItemLabel(null);
        return;
      }
      heldItemMesh.visible = true;
      if (!heldItemTextures[id]) {
        const icon = createItemIconCanvas(id, 64);
        const tex = new THREE.CanvasTexture(icon);
        tex.magFilter = THREE.NearestFilter;
        tex.minFilter = THREE.NearestFilter;
        tex.generateMipmaps = false;
        heldItemTextures[id] = tex;
      }
      if (heldItemMesh.material.map !== heldItemTextures[id]) {
        heldItemMesh.material.map = heldItemTextures[id];
        heldItemMesh.material.needsUpdate = true;
      }
      showHeldItemLabel(ITEM_DEFS[id].name);
    }

    function renderSurvivalMeters() {
      const isSurvival = appState.activeWorld?.mode === 'survival';
      els.survivalMeters.classList.toggle('hidden', !isSurvival);
      if (!isSurvival) return;

      els.healthBar.innerHTML = '';
      const hearts = Math.ceil(player.hp / 2);
      for (let i = 0; i < 10; i++) {
