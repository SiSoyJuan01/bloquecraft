    function handleResize() {
      if (!renderer || !camera) return;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, IS_MOBILE ? 1.25 : 2));
    }

    function applyGraphicsSettings() {
      if (camera) {
        camera.fov = Number(graphicsSettings.fov);
        camera.updateProjectionMatrix();
      }
      if (renderer) {
        renderer.shadowMap.enabled = Boolean(graphicsSettings.shadows);
        renderer.toneMappingExposure = Number(graphicsSettings.brightness) || 1.0;
      }
      if (sunLight) {
        sunLight.castShadow = Boolean(graphicsSettings.shadows);
      }
      if (voxelWorld) {
        voxelWorld.settings = graphicsSettings;
        for (const chunk of voxelWorld.chunks.values()) {
          if (chunk.meshOpaque) {
            chunk.meshOpaque.castShadow = Boolean(graphicsSettings.shadows);
            chunk.meshOpaque.receiveShadow = Boolean(graphicsSettings.shadows);
          }
        }
      }
      updateSkyAndLighting(0);
      storage.saveSettings(graphicsSettings);
    }

    function updateSkyAndLighting(dt) {
      if (!scene || !sunLight || !skyDome) return;
      timeOfDay = (timeOfDay + dt * 0.012 * graphicsSettings.cycleSpeed) % 1;

      const angle = timeOfDay * Math.PI * 2;
      const sunHeight = Math.sin(angle);
      const sunRadius = 90;

      const sx = player.pos.x + Math.cos(angle) * sunRadius;
      const sy = Math.max(-20, player.pos.y + sunHeight * sunRadius);
      const sz = player.pos.z + 30;

      sunLight.position.set(sx, sy, sz);
      sunLight.target.position.copy(player.pos);
      sunLight.target.updateMatrixWorld();
      skyDome.position.copy(player.pos);

      if (sunMesh && moonMesh) {
        const celestialDist = 145;
        sunMesh.position.set(
          player.pos.x + Math.cos(angle) * celestialDist,
          player.pos.y + Math.sin(angle) * celestialDist,
          player.pos.z - 25
        );
        sunMesh.lookAt(player.pos);

        const moonAngle = angle + Math.PI;
        moonMesh.position.set(
          player.pos.x + Math.cos(moonAngle) * celestialDist,
          player.pos.y + Math.sin(moonAngle) * celestialDist,
          player.pos.z - 25
        );
        moonMesh.lookAt(player.pos);
      }

      const dayFactor = Math.max(0, Math.min(1, (sunHeight + 0.25) / 0.65));
      const sunsetFactor = Math.max(0, 1 - Math.abs(sunHeight) * 3.5);
      const brightMult = Number(graphicsSettings.brightness) || 1.0;

      const nightSky = new THREE.Color(0x0b1224);
      const daySky = new THREE.Color(0x7cc4fa);
      const sunsetSky = new THREE.Color(0xe68455);

      const skyCol = nightSky.clone().lerp(daySky, dayFactor).lerp(sunsetSky, sunsetFactor * 0.45);
      skyDome.material.color.copy(skyCol);

      if (graphicsSettings.fog) {
        const fogDist = graphicsSettings.renderDistance * CHUNK_W * 0.92;
        if (!scene.fog) {
          scene.fog = new THREE.FogExp2(skyCol.getHex(), 1 / Math.max(48, fogDist * 1.15));
        } else {
          scene.fog.color.copy(skyCol);
          scene.fog.density = 1 / Math.max(48, fogDist * 1.15);
        }
      } else {
        scene.fog = null;
      }

      sunLight.intensity = (0.22 + dayFactor * 1.05) * brightMult;
      sunLight.color.setHex(sunsetFactor > 0.3 ? 0xffb370 : 0xfffbeb);
      hemiLight.intensity = (0.35 + dayFactor * 0.65) * brightMult;
    }

    function isNightTime() {
      const sunHeight = Math.sin(timeOfDay * Math.PI * 2);
      return sunHeight < -0.05;
    }

    function getClockLabel() {
      const totalMinutes = Math.floor(timeOfDay * 24 * 60);
      const hh = String(Math.floor(totalMinutes / 60)).padStart(2, '0');
      const mm = String(totalMinutes % 60).padStart(2, '0');
      const phase = isNightTime() ? 'Night' : 'Day';
      return `${hh}:${mm} (${phase})`;
    }

