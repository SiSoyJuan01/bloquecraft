    class BlockParticlePool {
      constructor(scene) {
        this.scene = scene;
        this.maxParticles = 180;
        this.particles = [];
        this.geom = new THREE.BoxGeometry(0.14, 0.14, 0.14);
        this.mat = new THREE.MeshLambertMaterial({ color: 0xffffff });
        this.instanced = new THREE.InstancedMesh(this.geom, this.mat, this.maxParticles);
        this.instanced.count = 0;
        this.instanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
        this.instanced.frustumCulled = false;
        this.scene.add(this.instanced);
        this._dummy = new THREE.Object3D();
      }

      spawnBurst(worldPos, blockId, count = 10) {
        const colorHex =
          blockId === BLOCK.GRASS ? 0x59a848 :
          blockId === BLOCK.DIRT ? 0x8d623e :
          blockId === BLOCK.SAND ? 0xe3cf8b :
          blockId === BLOCK.WOOD || blockId === BLOCK.PLANKS ? 0x8f5e32 :
          blockId === BLOCK.LEAVES ? 0x3f8834 :
          blockId === BLOCK.DIAMOND_ORE ? 0x4be8e0 :
          blockId === BLOCK.GOLD_ORE ? 0xf7d038 :
          blockId === BLOCK.IRON_ORE ? 0xd9b393 : 0x7f838a;

        for (let i = 0; i < count; i++) {
          if (this.particles.length >= this.maxParticles) {
            this.particles.shift();
          }
          this.particles.push({
            pos: worldPos.clone().add(new THREE.Vector3(
              (Math.random() - 0.5) * 0.5,
              (Math.random() - 0.5) * 0.5,
              (Math.random() - 0.5) * 0.5
            )),
            vel: new THREE.Vector3(
              (Math.random() - 0.5) * 4.5,
              1.8 + Math.random() * 3.5,
              (Math.random() - 0.5) * 4.5
            ),
            rot: new THREE.Vector3(Math.random() * 6, Math.random() * 6, Math.random() * 6),
            life: 0.45 + Math.random() * 0.25,
            maxLife: 0.7,
            color: new THREE.Color(colorHex)
          });
        }
      }

      update(dt) {
        let activeCount = 0;
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.life -= dt;
          if (p.life <= 0) {
            this.particles.splice(i, 1);
            continue;
          }
          p.vel.y -= 14 * dt;
          p.pos.addScaledVector(p.vel, dt);
          p.rot.x += dt * 7;
          p.rot.y += dt * 7;
          const scale = Math.max(0.05, p.life / p.maxLife);
          this._dummy.position.copy(p.pos);
          this._dummy.rotation.set(p.rot.x, p.rot.y, p.rot.z);
          this._dummy.scale.setScalar(scale);
          this._dummy.updateMatrix();
          this.instanced.setMatrixAt(activeCount, this._dummy.matrix);
          this.instanced.setColorAt(activeCount, p.color);
          activeCount++;
        }
        this.instanced.count = activeCount;
        this.instanced.instanceMatrix.needsUpdate = true;
        if (this.instanced.instanceColor) this.instanced.instanceColor.needsUpdate = true;
      }

      clear() {
        this.particles = [];
        this.instanced.count = 0;
        this.instanced.instanceMatrix.needsUpdate = true;
      }
    }

    class PickupEntityManager {
      constructor(scene, world) {
        this.scene = scene;
        this.world = world;
        this.items = [];
        this.maxInstances = 128;
        this.geom = new THREE.BoxGeometry(0.32, 0.32, 0.32);
        this.mat = new THREE.MeshLambertMaterial({ color: 0xffffff });
        this.instanced = new THREE.InstancedMesh(this.geom, this.mat, this.maxInstances);
        this.instanced.count = 0;
        this.instanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
        this.instanced.castShadow = true;
        this.instanced.frustumCulled = false;
        this.scene.add(this.instanced);
        this._dummy = new THREE.Object3D();
      }

      _itemTintColor(itemId) {
        switch (itemId) {
          case BLOCK.GRASS: return 0x62b34e;
          case BLOCK.DIRT: return 0x8d623e;
          case BLOCK.STONE:
          case BLOCK.COBBLESTONE: return 0x888c94;
          case BLOCK.SAND: return 0xe3cf8b;
          case BLOCK.WOOD:
          case BLOCK.PLANKS:
          case BLOCK.CRAFTING_TABLE: return 0xa87644;
          case BLOCK.LEAVES: return 0x3f8834;
          case BLOCK.GLASS: return 0xc8eef7;
          case BLOCK.COAL_ORE: return 0x3b3e45;
          case BLOCK.IRON_ORE: return 0xd9b393;
          case BLOCK.GOLD_ORE: return 0xf7d038;
          case BLOCK.DIAMOND_ORE: return 0x4be8e0;
          case BLOCK.TORCH_BLOCK: return 0xffcf56;
          case BLOCK.FURNACE: return 0x676b73;
          case BLOCK.RAW_MEAT: return 0xff858e;
          case BLOCK.BONE: return 0xf8fafc;
          default: return 0xc49158;
        }
      }

      spawn(itemId, count, pos, impulse = null) {
        if (!ITEM_DEFS[itemId] || count <= 0) return;
        if (this.items.length >= this.maxInstances) {
          this.items.shift();
        }
        const vx = impulse ? impulse.x : (Math.random() - 0.5) * 3.2;
        const vy = impulse ? impulse.y : 3.6;
        const vz = impulse ? impulse.z : (Math.random() - 0.5) * 3.2;

        this.items.push({
          itemId,
          count,
          pos: pos.clone(),
          rotY: Math.random() * Math.PI * 2,
          vel: new THREE.Vector3(vx, vy, vz),
          age: 0,
          bobPhase: Math.random() * Math.PI * 2,
          color: new THREE.Color(this._itemTintColor(itemId))
        });
      }

      update(dt, playerPos, onCollect) {
        let activeCount = 0;
        for (let i = this.items.length - 1; i >= 0; i--) {
          const it = this.items[i];
          it.age += dt;
          it.bobPhase += dt * 4.2;
          it.vel.y -= 16 * dt;

          const nextX = it.pos.x + it.vel.x * dt;
          const nextY = it.pos.y + it.vel.y * dt;
          const nextZ = it.pos.z + it.vel.z * dt;

          if (!ITEM_DEFS[this.world.getBlock(nextX, it.pos.y, it.pos.z)]?.solid) {
            it.pos.x = nextX;
          } else {
            it.vel.x = 0;
          }

          if (!ITEM_DEFS[this.world.getBlock(it.pos.x, it.pos.y, nextZ)]?.solid) {
            it.pos.z = nextZ;
          } else {
            it.vel.z = 0;
          }

          const belowBlock = this.world.getBlock(it.pos.x, nextY - 0.16, it.pos.z);
          if (ITEM_DEFS[belowBlock]?.solid) {
            it.pos.y = Math.floor(nextY - 0.16) + 1.16;
            it.vel.y = 0;
            it.vel.x *= 0.82;
            it.vel.z *= 0.82;
          } else {
            it.pos.y = nextY;
          }

          it.rotY += dt * 2.1;
          const renderY = it.pos.y + Math.sin(it.bobPhase) * 0.04;

          const dist = it.pos.distanceTo(new THREE.Vector3(playerPos.x, playerPos.y + 0.8, playerPos.z));
          if (it.age > 0.35 && dist < 2.4) {
            const dir = new THREE.Vector3(playerPos.x - it.pos.x, (playerPos.y + 0.8) - it.pos.y, playerPos.z - it.pos.z).normalize();
            it.pos.addScaledVector(dir, dt * 8.5);
          }
          if (it.age > 0.35 && dist < 1.35) {
            onCollect(it.itemId, it.count);
            this.items.splice(i, 1);
            continue;
          }

          if (it.age > 120) {
            this.items.splice(i, 1);
            continue;
          }

          this._dummy.position.set(it.pos.x, renderY, it.pos.z);
          this._dummy.rotation.set(0, it.rotY, 0);
          this._dummy.scale.setScalar(1);
          this._dummy.updateMatrix();
          this.instanced.setMatrixAt(activeCount, this._dummy.matrix);
          this.instanced.setColorAt(activeCount, it.color);
          activeCount++;
        }

        this.instanced.count = activeCount;
        this.instanced.instanceMatrix.needsUpdate = true;
        if (this.instanced.instanceColor) this.instanced.instanceColor.needsUpdate = true;
      }

      clear() {
        this.items = [];
        this.instanced.count = 0;
        this.instanced.instanceMatrix.needsUpdate = true;
      }
    }

