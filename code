<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BLOQUECRAFT BETA 1.0</title>
  <meta name="theme-color" content="#12161f">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <!-- Tailwind CSS for responsive layout & utility styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js UMD build with automatic fallback loader in script -->
  <script id="three-cdn-script" src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

    :root {
      --stone-dark: #1d1e22;
      --stone-mid: #2b2d34;
      --stone-light: #3d404a;
      --bedrock-border: #111215;
      --emerald: #3ba55d;
      --emerald-hover: #47be6d;
      --gold: #f5b942;
      --danger: #e04848;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #12161f;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: #f8fafc;
    }

    /* Bedrock-inspired bevel panels & buttons */
    .bedrock-panel {
      background: linear-gradient(180deg, rgba(44, 47, 56, 0.96) 0%, rgba(28, 30, 36, 0.98) 100%);
      border: 3px solid #121317;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -3px 0 rgba(0, 0, 0, 0.45), 0 12px 32px rgba(0, 0, 0, 0.65);
      border-radius: 10px;
    }

    .bedrock-slot {
      background: rgba(18, 20, 25, 0.85);
      border: 2px solid #101114;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      transition: transform 0.08s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    }

    .bedrock-slot.selected {
      border-color: #f5f5f5;
      box-shadow: 0 0 0 2px #111111, 0 0 0 3px rgba(255, 255, 255, 0.28), inset 0 2px 4px rgba(0, 0, 0, 0.5);
      transform: translateY(-1px);
    }

    .bedrock-btn {
      background: linear-gradient(180deg, #4a4e5c 0%, #343742 100%);
      border: 2px solid #111216;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.18), inset 0 -3px 0 rgba(0, 0, 0, 0.45), 0 4px 0 #111216;
      border-radius: 8px;
      transition: transform 0.08s ease, filter 0.12s ease;
      cursor: pointer;
    }

    .bedrock-btn:hover {
      filter: brightness(1.08);
    }

    .bedrock-btn:active {
      transform: translateY(2px);
      box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.6), 0 1px 0 #111216;
    }

    .bedrock-btn-primary {
      background: linear-gradient(180deg, #45b869 0%, #2f8e4e 100%);
      border: 2px solid #13281b;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.28), inset 0 -3px 0 rgba(0, 0, 0, 0.35), 0 4px 0 #13281b;
    }

    .bedrock-btn-danger {
      background: linear-gradient(180deg, #e05252 0%, #b53232 100%);
      border: 2px solid #2b1010;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.22), inset 0 -3px 0 rgba(0, 0, 0, 0.35), 0 4px 0 #2b1010;
    }

    /* Title block styling */
    .title-logo {
      font-family: 'Press Start 2P', 'Inter', monospace;
      letter-spacing: 0.02em;
      line-height: 1.5;
      text-shadow: 0 4px 0 #14161a, 0 8px 20px rgba(0, 0, 0, 0.75);
    }

    canvas.pixel-icon {
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    #game-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Custom scrollbar for modals */
    .custom-scroll::-webkit-scrollbar {
      width: 8px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: rgba(15, 17, 22, 0.6);
      border-radius: 4px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #4b5060;
      border-radius: 4px;
    }
  </style>
<base target="_blank">
</head>
<body>
  <!-- Root Application Container -->
  <div id="app" class="relative w-full h-full overflow-hidden">
    <!-- 3D Viewport Canvas -->
    <canvas id="game-canvas"></canvas>

    <!-- Main Menu Screen -->
    <div id="main-menu" class="absolute inset-0 z-30 flex flex-col items-center justify-center p-4 sm:p-6 bg-gradient-to-b from-sky-900/75 via-slate-900/80 to-slate-950/95 backdrop-blur-xs">
      <div class="bedrock-panel w-full max-w-xl p-6 sm:p-8 flex flex-col items-center text-center gap-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-bold tracking-wider uppercase">
          <span>Voxel Sandbox Engine</span>
          <span>•</span>
          <span>Three.js + WebGL</span>
        </div>

        <div>
          <h1 class="title-logo text-xl sm:text-3xl text-white">BLOQUECRAFT</h1>
          <p class="mt-1 text-amber-300 font-extrabold tracking-widest text-xs sm:text-sm uppercase">BETA 1.0 — BEDROCK-INSPIRED EDITION</p>
        </div>

        <p class="text-slate-300 text-xs sm:text-sm max-w-md leading-relaxed">
          Procedural biomes, caves, ores, crafting & smelting, day/night cycle, articulated voxel creatures, Creative flight, and Survival progression with IndexedDB + localStorage persistence.
        </p>

        <div class="w-full flex flex-col gap-3 mt-1">
          <button id="btn-open-worlds" class="bedrock-btn bedrock-btn-primary w-full py-3.5 px-5 text-white font-bold text-base sm:text-lg flex items-center justify-center gap-2">
            <span>▶</span>
            <span>Jugar / Mundos</span>
          </button>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button id="btn-main-graphics" class="bedrock-btn w-full py-3 px-4 text-slate-100 font-semibold text-sm sm:text-base flex items-center justify-center gap-2">
              <span>⚙</span>
              <span>Graphics Settings</span>
            </button>
            <button id="btn-main-docs" class="bedrock-btn w-full py-3 px-4 text-slate-100 font-semibold text-sm sm:text-base flex items-center justify-center gap-2">
              <span>📘</span>
              <span>Controls & Docs</span>
            </button>
          </div>
        </div>

        <div id="storage-status-badge" class="text-[11px] text-slate-400 pt-1">
          Storage: Initializing...
        </div>
      </div>
    </div>

    <!-- World Manager Screen -->
    <div id="world-screen" class="hidden absolute inset-0 z-30 flex items-center justify-center p-3 sm:p-6 bg-slate-950/85 backdrop-blur-sm">
      <div class="bedrock-panel w-full max-w-3xl max-h-[90vh] flex flex-col p-4 sm:p-6 gap-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white">World Manager</h2>
            <p class="text-xs text-slate-400">Create a new procedural world or resume a saved adventure</p>
          </div>
          <button id="btn-world-back" class="bedrock-btn px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-200">
            ← Back
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 overflow-y-auto custom-scroll pr-1">
          <!-- Create New World Form -->
          <div class="lg:col-span-5 bg-slate-900/70 border border-white/10 rounded-lg p-4 flex flex-col gap-3">
            <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Crear nuevo mundo</h3>

            <div>
              <label for="input-world-name" class="block text-xs font-semibold text-slate-300 mb-1">World Name</label>
              <input id="input-world-name" type="text" maxlength="32" placeholder="New Frontier" class="w-full px-3 py-2 rounded-md bg-slate-950 border border-white/15 text-sm text-white focus:outline-none focus:border-emerald-400" />
            </div>

            <div>
              <label for="input-world-seed" class="block text-xs font-semibold text-slate-300 mb-1">Seed (Text or Number)</label>
              <div class="flex gap-2">
                <input id="input-world-seed" type="text" maxlength="24" placeholder="Random Seed" class="w-full px-3 py-2 rounded-md bg-slate-950 border border-white/15 text-sm text-white focus:outline-none focus:border-emerald-400" />
                <button id="btn-random-seed" type="button" class="bedrock-btn px-3 py-2 text-xs font-bold text-amber-300" title="Generate random seed">🎲</button>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Game Mode</label>
              <div class="grid grid-cols-2 gap-2">
                <button id="mode-btn-survival" type="button" data-mode="survival" class="mode-select-btn bedrock-btn bedrock-btn-primary py-2 px-3 text-xs font-bold text-white">
                  Survival
                </button>
                <button id="mode-btn-creative" type="button" data-mode="creative" class="mode-select-btn bedrock-btn py-2 px-3 text-xs font-bold text-slate-200">
                  Creative
                </button>
              </div>
              <p id="mode-description" class="mt-1.5 text-[11px] text-slate-400 leading-snug">
                Health, hunger, mining drops, crafting, and creature combat.
              </p>
            </div>

            <button id="btn-create-launch-world" type="button" class="bedrock-btn bedrock-btn-primary w-full py-2.5 px-4 text-sm font-bold text-white mt-1">
              Crear y jugar
            </button>
          </div>

          <!-- Saved Worlds List -->
          <div class="lg:col-span-7 bg-slate-900/70 border border-white/10 rounded-lg p-4 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-amber-300">Saved Worlds</h3>
              <span id="saved-worlds-count" class="text-xs text-slate-400">0 worlds</span>
            </div>

            <div id="saved-worlds-list" class="flex flex-col gap-2.5 max-h-72 overflow-y-auto custom-scroll pr-1">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Gameplay HUD -->
    <div id="hud" class="hidden absolute inset-0 z-10 pointer-events-none">
      <!-- Top Bar: Mode/Biome/Clock + Pause & Inventory triggers -->
      <div class="flex flex-wrap items-start justify-between gap-2 p-2.5 sm:p-4">
        <div class="bedrock-panel px-3 py-2 flex flex-col gap-0.5 text-xs pointer-events-auto">
          <div class="flex items-center gap-2 font-bold">
            <span id="hud-world-name" class="text-white">World</span>
            <span id="hud-mode-badge" class="px-1.5 py-0.5 rounded text-[10px] uppercase bg-emerald-500/25 text-emerald-300 border border-emerald-400/30">SURVIVAL</span>
            <span id="hud-flight-badge" class="hidden px-1.5 py-0.5 rounded text-[10px] uppercase bg-sky-500/25 text-sky-300 border border-sky-400/30">FLYING</span>
          </div>
          <div id="hud-telemetry" class="text-[11px] text-slate-300 font-mono">
            Biome: Plains • Time: Day • FPS: 60
          </div>
          <div id="hud-coords" class="text-[10px] text-slate-400 font-mono">
            XYZ: 0.0, 24.0, 0.0
          </div>
        </div>

        <div class="flex items-center gap-2 pointer-events-auto">
          <button id="hud-btn-inv" class="bedrock-btn px-3 py-2 text-xs font-bold text-white flex items-center gap-1.5" title="Inventory & Crafting (E)">
            <span>🎒</span>
            <span class="hidden sm:inline">Inventory [E]</span>
          </button>
          <button id="hud-btn-sound" class="bedrock-btn px-3 py-2 text-xs font-bold text-white flex items-center gap-1" title="Sonido">🔊</button>
          <button id="hud-btn-full" class="bedrock-btn px-3 py-2 text-xs font-bold text-white flex items-center gap-1" title="Pantalla completa">⛶</button>
          <button id="hud-btn-pause" class="bedrock-btn px-3 py-2 text-xs font-bold text-white flex items-center gap-1.5" title="Pause Menu (ESC)">
            <span>⏸</span>
            <span class="hidden sm:inline">Pause [ESC]</span>
          </button>
        </div>
      </div>

      <!-- Center Crosshair & Mining Progress -->
      <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
        <div class="relative w-5 h-5 flex items-center justify-center">
          <div class="w-4 h-0.5 bg-black" style="box-shadow:0 0 0 1px rgba(255,255,255,0.9)"></div>
          <div class="h-4 w-0.5 bg-black absolute" style="box-shadow:0 0 0 1px rgba(255,255,255,0.9)"></div>
        </div>
        <div id="mining-progress-wrap" class="hidden mt-4 w-24 h-2 rounded-full bg-black/60 border border-white/30 overflow-hidden">
          <div id="mining-progress-bar" class="h-full bg-amber-400 w-0 transition-none"></div>
        </div>
        <div id="target-block-label" class="mt-1.5 px-2 py-0.5 rounded bg-black/55 text-[11px] font-semibold text-slate-100 opacity-0 transition-opacity"></div>
      </div>

      <!-- Pointer Lock / Touch Helper Banner -->
      <div id="pointer-hint" class="hidden absolute top-20 left-1/2 -translate-x-1/2 px-3.5 py-1.5 rounded-full bg-black/70 border border-white/15 text-[11px] sm:text-xs text-slate-200 pointer-events-auto cursor-pointer">
        Click canvas to lock mouse look • WASD move • Space jump • LMB mine • RMB place • E inventory
      </div>

      <!-- Toast Notification -->
      <div id="toast-banner" class="hidden absolute top-28 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-lg bg-slate-900/90 border border-emerald-400/40 text-xs font-semibold text-emerald-200 shadow-lg"></div>

      <!-- Touch / Mobile Controls Overlay -->
      <div id="touch-controls" class="sm:hidden absolute bottom-24 inset-x-3 flex items-end justify-between pointer-events-none">
        <div class="grid grid-cols-3 gap-1.5 pointer-events-auto">
          <div></div>
          <button data-touch="w" class="touch-key w-11 h-11 rounded-lg bg-slate-900/75 border border-white/20 text-sm font-bold flex items-center justify-center active:bg-emerald-500/60">▲</button>
          <div></div>
          <button data-touch="a" class="touch-key w-11 h-11 rounded-lg bg-slate-900/75 border border-white/20 text-sm font-bold flex items-center justify-center active:bg-emerald-500/60">◀</button>
          <button data-touch="s" class="touch-key w-11 h-11 rounded-lg bg-slate-900/75 border border-white/20 text-sm font-bold flex items-center justify-center active:bg-emerald-500/60">▼</button>
          <button data-touch="d" class="touch-key w-11 h-11 rounded-lg bg-slate-900/75 border border-white/20 text-sm font-bold flex items-center justify-center active:bg-emerald-500/60">▶</button>
        </div>
        <div class="flex flex-col gap-2 pointer-events-auto">
          <button id="touch-btn-place" class="w-12 h-12 rounded-xl bg-emerald-700/80 border border-white/25 text-[11px] font-bold flex items-center justify-center">Place</button>
          <button id="touch-btn-mine" class="w-12 h-12 rounded-xl bg-amber-700/80 border border-white/25 text-[11px] font-bold flex items-center justify-center">Mine</button>
          <button id="touch-btn-jump" class="w-12 h-12 rounded-xl bg-slate-900/80 border border-white/25 text-[11px] font-bold flex items-center justify-center">Jump</button>
        </div>
      </div>

      <!-- Bottom HUD: Survival Health & Hunger + 9-Slot Hotbar -->
      <div class="absolute bottom-2.5 sm:bottom-4 inset-x-0 flex flex-col items-center gap-1.5 px-2">
        <div id="survival-meters" class="w-full max-w-lg flex items-center justify-between px-1 sm:px-2">
          <div id="health-bar" class="flex items-center gap-0.5 bg-slate-950/65 px-2 py-1 rounded-md border border-white/10" title="Health"></div>
          <div id="hunger-bar" class="flex items-center gap-0.5 bg-slate-950/65 px-2 py-1 rounded-md border border-white/10" title="Hunger"></div>
        </div>

        <div id="held-item-label" class="px-3 py-1 rounded bg-black/60 border border-white/15 text-xs sm:text-sm font-bold text-white opacity-0 transition-opacity duration-300 pointer-events-none"></div>
        <div id="hotbar" class="bedrock-panel p-1.5 flex items-center gap-1 sm:gap-1.5 pointer-events-auto"></div>
      </div>
    </div>

    <!-- Inventory & Crafting Modal (E / I) -->
    <div id="inventory-modal" class="hidden absolute inset-0 z-40 flex items-center justify-center p-3 sm:p-5 bg-slate-950/80 backdrop-blur-xs">
      <div class="bedrock-panel w-full max-w-4xl max-h-[92vh] flex flex-col p-4 sm:p-6 gap-4 overflow-y-auto custom-scroll">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <div>
            <h2 class="text-lg sm:text-2xl font-extrabold text-white">Inventory & Crafting</h2>
            <p class="text-xs text-slate-400">Click an item to assign to selected hotbar slot, or craft & smelt items</p>
          </div>
          <button id="btn-close-inventory" class="bedrock-btn px-3.5 py-2 text-xs sm:text-sm font-bold text-white">✕ Close [E]</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-5 bg-slate-900/75 border border-white/10 rounded-lg p-3.5 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-amber-300">Crafting & Smelting</h3>
              <span id="crafting-mode-note" class="text-[11px] text-slate-400">Survival</span>
            </div>
            <div id="crafting-recipes-list" class="flex flex-col gap-2 max-h-64 overflow-y-auto custom-scroll pr-1"></div>
          </div>

          <div class="lg:col-span-7 bg-slate-900/75 border border-white/10 rounded-lg p-3.5 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Blocks & Items</h3>
              <span id="creative-inf-badge" class="hidden text-[11px] px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-400/30 font-semibold">Creative: Infinite Supply</span>
            </div>
            <div id="inventory-grid" class="grid grid-cols-5 sm:grid-cols-7 gap-2 max-h-64 overflow-y-auto custom-scroll pr-1"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pause Menu Modal -->
    <div id="pause-modal" class="hidden absolute inset-0 z-40 flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-xs">
      <div class="bedrock-panel w-full max-w-md p-6 flex flex-col gap-3 text-center">
        <h2 class="text-2xl font-extrabold text-white mb-1">Game Paused</h2>
        <p class="text-xs text-slate-400 mb-2">Progress auto-saves to IndexedDB & localStorage</p>

        <button id="btn-resume-game" class="bedrock-btn bedrock-btn-primary w-full py-3 px-4 text-sm sm:text-base font-bold text-white">
          ▶ Resume Game
        </button>
        <button id="btn-pause-graphics" class="bedrock-btn w-full py-3 px-4 text-sm sm:text-base font-semibold text-slate-100">
          ⚙ Graphics Settings
        </button>
        <button id="btn-pause-docs" class="bedrock-btn w-full py-3 px-4 text-sm sm:text-base font-semibold text-slate-100">
          📘 Controls & Docs
        </button>
        <button id="btn-save-quit" class="bedrock-btn bedrock-btn-danger w-full py-3 px-4 text-sm sm:text-base font-bold text-white mt-1">
          💾 Save & Quit to Title
        </button>
      </div>
    </div>

    <!-- Graphics Settings Modal -->
    <div id="graphics-modal" class="hidden absolute inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-xs">
      <div class="bedrock-panel w-full max-w-lg p-5 sm:p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <h2 class="text-xl font-extrabold text-white">Graphics Settings</h2>
          <button id="btn-close-graphics" class="bedrock-btn px-3 py-1.5 text-xs font-bold text-white">✕ Done</button>
        </div>

        <div class="flex flex-col gap-4 text-sm">
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-200">Render Distance (Chunk Radius)</span>
              <span id="val-render-dist" class="text-emerald-300 font-mono">4 chunks</span>
            </div>
            <input id="setting-render-dist" type="range" min="2" max="7" step="1" value="4" class="w-full accent-emerald-400" />
            <p class="text-[11px] text-slate-400 mt-0.5">Lower values boost FPS on modest devices.</p>
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-200">Field of View (FOV)</span>
              <span id="val-fov" class="text-emerald-300 font-mono">75°</span>
            </div>
            <input id="setting-fov" type="range" min="55" max="105" step="1" value="75" class="w-full accent-emerald-400" />
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-200">Camera Sensitivity</span>
              <span id="val-sensitivity" class="text-emerald-300 font-mono">1.0x</span>
            </div>
            <input id="setting-sensitivity" type="range" min="0.2" max="2.5" step="0.1" value="1.0" class="w-full accent-emerald-400" />
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-200">Day / Night Cycle Speed</span>
              <span id="val-cycle-speed" class="text-emerald-300 font-mono">1.0x</span>
            </div>
            <input id="setting-cycle-speed" type="range" min="0" max="6" step="0.25" value="1.0" class="w-full accent-emerald-400" />
            <p class="text-[11px] text-slate-400 mt-0.5">Set to 0.0x to freeze time of day.</p>
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-200">Scene Brightness</span>
              <span id="val-brightness" class="text-emerald-300 font-mono">1.00x</span>
            </div>
            <input id="setting-brightness" type="range" min="0.6" max="1.6" step="0.05" value="1.0" class="w-full accent-emerald-400" />
