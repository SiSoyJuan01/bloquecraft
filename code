    let heldItemLabelTimer = null;
    function showHeldItemLabel(name) {
      const label = document.getElementById('held-item-label');
      if (!label) return;
      if (!name) { label.style.opacity = '0'; return; }
      label.textContent = name;
      label.style.opacity = '1';
      clearTimeout(heldItemLabelTimer);
      heldItemLabelTimer = setTimeout(() => { label.style.opacity = '0'; }, 1600);
