      hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x4b5563, 0.85);
      scene.add(hemiLight);

      sunLight = new THREE.DirectionalLight(0xfffbeb, 1.15);
      sunLight.position.set(45, 75, 35);
      sunLight.castShadow = Boolean(graphicsSettings.shadows);
      sunLight.shadow.mapSize.width = 1024;
