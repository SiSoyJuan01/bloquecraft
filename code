    function addItemToInventory(itemId, count = 1) {
      if (!ITEM_DEFS[itemId] || count <= 0) return;
      if (appState.activeWorld?.mode === 'creative') {
        player.inventory[itemId] = 99;
        renderHotbar();
        return;
      }
      player.inventory[itemId] = (player.inventory[itemId] || 0) + count;
      if (!player.hotbar.includes(itemId)) {
        const emptyIdx = player.hotbar.findIndex((s) => s === null || s === undefined);
        if (emptyIdx !== -1) {
          player.hotbar[emptyIdx] = itemId;
        }
      }
      renderHotbar();
      if (!els.inventoryModal.classList.contains('hidden')) {
        renderInventoryAndCrafting();
      }
    }

    function consumeItemFromInventory(itemId, count = 1) {
      if (!ITEM_DEFS[itemId] || count <= 0) return true;
      if (appState.activeWorld?.mode === 'creative') return true;
      const cur = player.inventory[itemId] || 0;
      if (cur < count) return false;
      const next = cur - count;
      if (next <= 0) {
        delete player.inventory[itemId];
      } else {
        player.inventory[itemId] = next;
      }
      renderHotbar();
      return true;
    }

    function getSelectedHotbarItemId() {
      return player.hotbar[player.selectedSlot] || null;
    }

    function renderHotbar() {
      els.hotbar.innerHTML = '';
      for (let i = 0; i < 9; i++) {
        const itemId = player.hotbar[i];
        const slot = document.createElement('button');
        slot.type = 'button';
        slot.className = `bedrock-slot relative w-9 h-9 sm:w-11 sm:h-11 flex items-center justify-center ${i === player.selectedSlot ? 'selected' : ''}`;
        slot.title = itemId ? ITEM_DEFS[itemId]?.name : `Slot ${i + 1}`;
        slot.addEventListener('click', () => {
          player.selectedSlot = i;
          renderHotbar();
          const id = getSelectedHotbarItemId();
          const def = ITEM_DEFS[id];
          if (def && def.foodRestore && appState.activeWorld?.mode === 'survival') {
            if (player.hunger < player.maxHunger || player.hp < player.maxHp) {
              consumeItemFromInventory(id, 1);
              player.hunger = Math.min(player.maxHunger, player.hunger + def.foodRestore * 2);
              player.hp = Math.min(player.maxHp, player.hp + def.foodRestore);
              renderSurvivalMeters();
              showToast(`Ate ${def.name}`);
            }
          }
        });

        const keyTag = document.createElement('span');
        keyTag.className = 'absolute top-0.5 left-1 text-[9px] font-bold text-slate-400 leading-none';
        keyTag.textContent = String(i + 1);
        slot.appendChild(keyTag);

        if (itemId && ITEM_DEFS[itemId]) {
          const icon = createItemIconCanvas(itemId, 28);
          slot.appendChild(icon);

          if (ITEM_DEFS[itemId].stackable) {
            const count = appState.activeWorld?.mode === 'creative' ? '∞' : (player.inventory[itemId] || 0);
            if (count !== 0) {
              const badge = document.createElement('span');
              badge.className = 'absolute bottom-0.5 right-1 text-[10px] font-extrabold text-white drop-shadow leading-none';
              badge.textContent = String(count);
              slot.appendChild(badge);
            }
          }
        }

        els.hotbar.appendChild(slot);
      }
      updateHeldItem();
