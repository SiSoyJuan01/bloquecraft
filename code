    function ensureThreeLoaded(callback) {
      if (window.THREE && window.THREE.WebGLRenderer) {
        callback();
        return;
      }
      let idx = 0;
      const tryNext = () => {
        if (window.THREE && window.THREE.WebGLRenderer) {
          callback();
          return;
        }
        if (idx >= THREE_FALLBACK_URLS.length) {
          showToast('Unable to load Three.js from CDN. Please check network access.', 8000);
          return;
        }
        const s = document.createElement('script');
        s.src = THREE_FALLBACK_URLS[idx++];
        s.onload = () => {
          if (window.THREE) callback();
          else tryNext();
        };
        s.onerror = tryNext;
        document.head.appendChild(s);
      };
      setTimeout(tryNext, 150);
