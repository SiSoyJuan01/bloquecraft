        tile.type = 'button';
        tile.className = 'bedrock-slot relative h-12 flex items-center justify-center';
        tile.title = `${ITEM_DEFS[id].name} — Click to equip to hotbar slot ${player.selectedSlot + 1}`;
        tile.appendChild(createItemIconCanvas(id, 30));

        if (ITEM_DEFS[id].stackable) {
          const cLabel = document.createElement('span');
