    function toggleInventory(forceClose = false) {
      if (appState.screen !== 'playing' && appState.screen !== 'paused') return;
      const isOpen = !els.inventoryModal.classList.contains('hidden');
      if (forceClose || isOpen) {
        els.inventoryModal.classList.add('hidden');
        if (appState.screen === 'playing') requestCanvasPointerLock();
      } else {
        exitPointerLockSafe();
        renderInventoryAndCrafting();
        els.inventoryModal.classList.remove('hidden');
      }
    }

    // ============================================================================
    // 11. PLAYER PHYSICS, COLLISION, RAYCASTING & INTERACTION
    // ============================================================================
    function isAnyModalOpen() {
      return (
        !els.inventoryModal.classList.contains('hidden') ||
        !els.graphicsModal.classList.contains('hidden') ||
        !els.docsModal.classList.contains('hidden') ||
        !els.respawnModal.classList.contains('hidden')
      );
    }

    function requestCanvasPointerLock() {
      if (appState.screen !== 'playing' || isAnyModalOpen()) return;
      try {
        if (els.canvas.requestPointerLock && document.pointerLockElement !== els.canvas) {
          const p = els.canvas.requestPointerLock();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        }
      } catch {
        // Fallback drag look still works seamlessly
      }
    }

    function exitPointerLockSafe() {
      try {
        if (document.pointerLockElement) {
          document.exitPointerLock();
        }
      } catch {
        // Ignore
      }
    }

    function collidesAtBox(px, py, pz) {
      const hw = player.width * 0.5;
      const minX = Math.floor(px - hw);
      const maxX = Math.floor(px + hw);
      const minY = Math.floor(py);
      const maxY = Math.floor(py + player.height);
      const minZ = Math.floor(pz - hw);
      const maxZ = Math.floor(pz + hw);

      for (let y = minY; y <= maxY; y++) {
        for (let z = minZ; z <= maxZ; z++) {
          for (let x = minX; x <= maxX; x++) {
            const b = voxelWorld.getBlock(x, y, z);
            if (ITEM_DEFS[b]?.solid) return true;
          }
        }
      }
      return false;
    }

    function playerIntersectsBlock(bx, by, bz) {
      const hw = player.width * 0.5;
      const pMinX = player.pos.x - hw;
      const pMaxX = player.pos.x + hw;
      const pMinY = player.pos.y;
      const pMaxY = player.pos.y + player.height;
      const pMinZ = player.pos.z - hw;
      const pMaxZ = player.pos.z + hw;

      return (
        pMaxX > bx && pMinX < bx + 1 &&
        pMaxY > by && pMinY < by + 1 &&
        pMaxZ > bz && pMinZ < bz + 1
      );
    }

    function hurtPlayer(amount, sourceLabel = 'Hazard') {
      Sfx.play('hurt');
      if (!appState.activeWorld || appState.activeWorld.mode !== 'survival' || appState.isDead) return;
      player.hp = Math.max(0, player.hp - amount);
      renderSurvivalMeters();
      if (player.hp <= 0) {
        appState.isDead = true;
        isMiningHeld = false;
        miningProgress = 0;
        exitPointerLockSafe();
        els.respawnModal.classList.remove('hidden');
        showToast(`Defeated by ${sourceLabel}`);
      }
    }

    function respawnPlayer() {
      if (!voxelWorld) return;
      const sy = voxelWorld.findSafeSpawnY(0, 0);
      player.pos.set(0, sy, 0);
      player.vel.set(0, 0, 0);
      player.hp = player.maxHp;
      player.hunger = player.maxHunger;
      player.fallStartY = null;
      appState.isDead = false;
      els.respawnModal.classList.add('hidden');
      renderSurvivalMeters();
      requestCanvasPointerLock();
      showToast('Respawned');
    }

    function updatePlayerPhysics(dt) {
      if (!voxelWorld || appState.isDead) return;

      const moveForward = (keys['KeyW'] || touchKeys['w'] ? 1 : 0) - (keys['KeyS'] || touchKeys['s'] ? 1 : 0);
      const moveRight = (keys['KeyD'] || touchKeys['d'] ? 1 : 0) - (keys['KeyA'] || touchKeys['a'] ? 1 : 0);

      const forwardVec = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
      const rightVec = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));

      const wishDir = new THREE.Vector3();
      wishDir.addScaledVector(forwardVec, moveForward);
      wishDir.addScaledVector(rightVec, moveRight);
      if (wishDir.lengthSq() > 0) wishDir.normalize();

      const isCreative = appState.activeWorld?.mode === 'creative';
      const speed = player.flying ? 11.5 : 5.4;

      if (player.flying && isCreative) {
        player.vel.x = wishDir.x * speed;
        player.vel.z = wishDir.z * speed;
        let vy = 0;
        if (keys['Space'] || touchKeys['jump']) vy += 7.5;
        if (keys['ShiftLeft'] || keys['ShiftRight']) vy -= 7.5;
        player.vel.y = vy;
        player.fallStartY = null;
      } else {
        player.flying = false;
        player.vel.x = wishDir.x * speed;
        player.vel.z = wishDir.z * speed;

        if ((keys['Space'] || touchKeys['jump']) && player.onGround) {
          player.vel.y = 7.8;
          player.onGround = false;
          if (player.fallStartY === null) player.fallStartY = player.pos.y;
        }

        player.vel.y -= 21.5 * dt;
        player.vel.y = Math.max(-36, player.vel.y);
      }

      const nextX = player.pos.x + player.vel.x * dt;
      if (!collidesAtBox(nextX, player.pos.y, player.pos.z)) {
        player.pos.x = nextX;
      } else {
        player.vel.x = 0;
      }

      const nextZ = player.pos.z + player.vel.z * dt;
      if (!collidesAtBox(player.pos.x, player.pos.y, nextZ)) {
        player.pos.z = nextZ;
      } else {
        player.vel.z = 0;
      }

      const prevOnGround = player.onGround;
      const nextY = player.pos.y + player.vel.y * dt;
      if (player.vel.y < 0 && player.fallStartY === null && !prevOnGround) {
        player.fallStartY = player.pos.y;
      }

      if (!collidesAtBox(player.pos.x, nextY, player.pos.z)) {
        player.pos.y = nextY;
        player.onGround = false;
      } else {
        if (player.vel.y < 0) {
          player.onGround = true;
          if (!isCreative && player.fallStartY !== null) {
            const fallDist = player.fallStartY - player.pos.y;
            if (fallDist > 5.2) {
              const dmg = Math.min(12, Math.floor((fallDist - 4.5) * 1.6));
              if (dmg > 0) hurtPlayer(dmg, 'Fall');
            }
          }
          player.fallStartY = null;
        }
        player.vel.y = 0;
      }

      if (player.pos.y < 1) {
        player.pos.y = voxelWorld.findSafeSpawnY(player.pos.x, player.pos.z);
        player.vel.y = 0;
        if (!isCreative) hurtPlayer(4, 'Deep Cavern');
      }

      if (!isCreative && appState.activeWorld?.mode === 'survival') {
        const moving = wishDir.lengthSq() > 0.01;
        player.hungerTimer += dt * (moving ? 1.4 : 0.45);
        if (player.hungerTimer >= 14) {
          player.hungerTimer = 0;
          player.hunger = Math.max(0, player.hunger - 1);
          renderSurvivalMeters();
        }

        if (player.hunger >= 16 && player.hp < player.maxHp) {
          player.regenTimer += dt;
          if (player.regenTimer >= 4.5) {
            player.regenTimer = 0;
            player.hp = Math.min(player.maxHp, player.hp + 1);
            renderSurvivalMeters();
          }
        } else {
          player.regenTimer = 0;
        }

        if (player.hunger === 0) {
          player.regenTimer += dt;
          if (player.regenTimer >= 5.0) {
            player.regenTimer = 0;
            hurtPlayer(1, 'Starvation');
          }
        }
      }

      camera.position.set(player.pos.x, player.pos.y + player.eyeHeight, player.pos.z);
      camera.rotation.y = player.yaw;
      camera.rotation.x = player.pitch;

      els.hudFlightBadge.classList.toggle('hidden', !(player.flying && isCreative));
    }

    function raycastBlocksAndMobs() {
      const origin = camera.position.clone();
      const dir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();

      let hitMob = null;
      let bestMobDist = 4.6;
      if (creatures) {
        for (const mob of creatures.mobs) {
          const center = mob.mesh.position.clone().add(new THREE.Vector3(0, mob.spec.height * 0.55, 0));
          const toMob = center.clone().sub(origin);
          const proj = toMob.dot(dir);
          if (proj > 0 && proj < bestMobDist) {
            const perpSq = toMob.lengthSq() - proj * proj;
            const r = mob.spec.width * 0.85;
            if (perpSq <= r * r) {
              bestMobDist = proj;
              hitMob = mob;
            }
          }
        }
      }

      const step = 0.06;
      const maxDist = 5.6;
      let prevX = Math.floor(origin.x);
      let prevY = Math.floor(origin.y);
      let prevZ = Math.floor(origin.z);

      for (let t = 0.2; t <= maxDist; t += step) {
        const px = origin.x + dir.x * t;
        const py = origin.y + dir.y * t;
        const pz = origin.z + dir.z * t;
        const bx = Math.floor(px);
        const by = Math.floor(py);
        const bz = Math.floor(pz);

        const b = voxelWorld.getBlock(bx, by, bz);
        if (b !== BLOCK.AIR && b !== BLOCK.WATER) {
          return {
            hitMob,
            hitBlock: {
              x: bx, y: by, z: bz,
              prevX, prevY, prevZ,
              blockId: b,
              dist: t
            }
          };
        }

        prevX = bx;
        prevY = by;
        prevZ = bz;
      }

      return { hitMob, hitBlock: null };
    }

    function handlePrimaryAction(dt, justClicked = false) {
      if (!voxelWorld || appState.isDead) return;
      const { hitMob, hitBlock } = raycastBlocksAndMobs();

      if (justClicked && hitMob) {
        const heldId = getSelectedHotbarItemId();
        const heldDef = ITEM_DEFS[heldId];
        const dmg = heldDef?.attackDamage || 2;
        const dir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
        const killed = creatures.damageMob(hitMob, dmg, dir);
        if (particles) {
          particles.spawnBurst(hitMob.mesh.position.clone().add(new THREE.Vector3(0, 0.7, 0)), BLOCK.DIRT, 8);
        }
        showToast(killed ? `Defeated ${hitMob.spec.label}` : `Hit ${hitMob.spec.label} (-${dmg} HP)`);
        return;
      }

      if (!hitBlock) {
        miningProgress = 0;
        miningTargetKey = null;
        els.miningWrap.classList.add('hidden');
        return;
      }

      const def = ITEM_DEFS[hitBlock.blockId];
      if (!def || def.hardness === Infinity || hitBlock.blockId === BLOCK.BEDROCK) {
        miningProgress = 0;
        els.miningWrap.classList.add('hidden');
        if (justClicked && hitBlock.blockId === BLOCK.BEDROCK) {
          showToast('Bedrock cannot be broken');
        }
        return;
      }

      const targetKey = `${hitBlock.x},${hitBlock.y},${hitBlock.z}`;
      if (miningTargetKey !== targetKey) {
        miningTargetKey = targetKey;
        miningProgress = 0;
      }

      const heldId = getSelectedHotbarItemId();
      const heldDef = ITEM_DEFS[heldId];
      let toolMult = 1.0;
      if (heldDef?.toolPower) {
        toolMult = heldDef.toolPower;
      }

      const isCreative = appState.activeWorld?.mode === 'creative';
      const breakDuration = isCreative ? 0.08 : Math.max(0.14, def.hardness / toolMult);

      miningProgress += (justClicked ? breakDuration * 0.35 : dt);
      els.miningWrap.classList.remove('hidden');
      els.miningBar.style.width = `${Math.min(100, (miningProgress / breakDuration) * 100)}%`;

      if (miningProgress >= breakDuration) {
        const brokenBlockId = hitBlock.blockId;
        voxelWorld.setBlock(hitBlock.x, hitBlock.y, hitBlock.z, BLOCK.AIR);
        Sfx.play("break");
        miningProgress = 0;
        miningTargetKey = null;
        els.miningWrap.classList.add('hidden');

        if (particles) {
          particles.spawnBurst(
            new THREE.Vector3(hitBlock.x + 0.5, hitBlock.y + 0.5, hitBlock.z + 0.5),
            brokenBlockId,
            12
          );
        }

        if (!isCreative && def.drop) {
          pickups.spawn(
            def.drop,
            1,
            new THREE.Vector3(hitBlock.x + 0.5, hitBlock.y + 0.5, hitBlock.z + 0.5)
          );
        }
      }
    }

    function handlePlaceBlockAction() {
      if (!voxelWorld || appState.isDead) return;
      const { hitBlock } = raycastBlocksAndMobs();
      if (!hitBlock) return;

      if ((hitBlock.blockId === BLOCK.CRAFTING_TABLE || hitBlock.blockId === BLOCK.FURNACE) && !keys['ShiftLeft']) {
        toggleInventory(false);
        return;
      }

      const heldId = getSelectedHotbarItemId();
      const def = ITEM_DEFS[heldId];
      if (!def || !def.isBlock) {
        showToast('Select a placeable block in your hotbar');
        return;
      }

      const px = hitBlock.prevX;
      const py = hitBlock.prevY;
      const pz = hitBlock.prevZ;
      if (py < 1 || py > WORLD_MAX_Y) return;

      const existing = voxelWorld.getBlock(px, py, pz);
      if (existing !== BLOCK.AIR && existing !== BLOCK.WATER) return;

      if (def.solid && playerIntersectsBlock(px, py, pz)) {
        return;
      }

      if (consumeItemFromInventory(heldId, 1)) {
        voxelWorld.setBlock(px, py, pz, heldId);
        Sfx.play("place");
      }
    }

