    async function refreshWorldManagerUI() {
      appState.worldsList = await storage.listWorlds();
      els.savedWorldsCount.textContent = `${appState.worldsList.length} ${appState.worldsList.length === 1 ? 'world' : 'worlds'}`;
      els.savedWorldsList.innerHTML = '';

      if (appState.worldsList.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'text-xs text-slate-400 text-center py-8 border border-dashed border-white/15 rounded-lg';
        empty.textContent = 'No saved worlds yet. Create one on the left to start exploring!';
        els.savedWorldsList.appendChild(empty);
        return;
      }

      for (const w of appState.worldsList) {
        const card = document.createElement('div');
        card.className = 'flex flex-wrap items-center justify-between gap-3 bg-slate-950/75 border border-white/10 rounded-lg p-3';

        const meta = document.createElement('div');
        meta.className = 'min-w-0';
        const titleRow = document.createElement('div');
        titleRow.className = 'flex items-center gap-2';

        const nameEl = document.createElement('span');
        nameEl.className = 'text-sm font-bold text-white truncate';
        nameEl.textContent = w.name;

        const modeEl = document.createElement('span');
        modeEl.className = `px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
          w.mode === 'creative'
            ? 'bg-sky-500/20 text-sky-300 border border-sky-400/30'
            : 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/30'
        }`;
        modeEl.textContent = w.mode;

        titleRow.appendChild(nameEl);
        titleRow.appendChild(modeEl);

        const subEl = document.createElement('div');
        subEl.className = 'text-[11px] text-slate-400 mt-0.5';
        const dateStr = new Date(w.lastPlayed || Date.now()).toLocaleDateString();
        subEl.textContent = `Seed: ${w.seed} • Last played: ${dateStr}`;

        meta.appendChild(titleRow);
        meta.appendChild(subEl);

        const actions = document.createElement('div');
        actions.className = 'flex items-center gap-2';

        const playBtn = document.createElement('button');
        playBtn.type = 'button';
        playBtn.className = 'bedrock-btn bedrock-btn-primary px-3 py-1.5 text-xs font-bold text-white';
        playBtn.textContent = 'Jugar';
        playBtn.addEventListener('click', () => {
          pendingDeleteWorldId = null;
          startWorldSession(w.id);
        });

        const isConfirmingDelete = pendingDeleteWorldId === w.id;
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = `bedrock-btn bedrock-btn-danger px-2.5 py-1.5 text-xs font-bold text-white ${isConfirmingDelete ? 'ring-2 ring-amber-300' : ''}`;
        delBtn.textContent = isConfirmingDelete ? 'Confirm?' : 'Delete';
        delBtn.addEventListener('click', async () => {
          if (pendingDeleteWorldId !== w.id) {
            pendingDeleteWorldId = w.id;
            await refreshWorldManagerUI();
            return;
          }
          pendingDeleteWorldId = null;
          await storage.deleteWorld(w.id);
          showToast(`Deleted "${w.name}"`);
          await refreshWorldManagerUI();
        });

        actions.appendChild(playBtn);
        actions.appendChild(delBtn);

        card.appendChild(meta);
        card.appendChild(actions);
        els.savedWorldsList.appendChild(card);
      }
    }

    async function createAndLaunchNewWorld() {
      const rawName = els.worldNameInput.value.trim();
      const name = rawName || `World ${appState.worldsList.length + 1}`;
      const rawSeed = els.worldSeedInput.value.trim();
      const seed = rawSeed || String(Math.floor(100000 + Math.random() * 900000));
      const mode = appState.selectedCreateMode;

      const worldRecord = {
        id: `world_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
        name,
        seed,
        mode,
        createdAt: Date.now(),
        lastPlayed: Date.now(),
        timeOfDay: 0.25,
        player: null,
        inventory: null,
        hotbar: null,
        edits: {}
      };

      await storage.saveWorld(worldRecord);
      await startWorldSession(worldRecord.id);
    }

    async function startWorldSession(worldId) {
      const record = await storage.loadWorld(worldId);
      if (!record) {
        showToast('Could not load world data');
        return;
      }

      if (voxelWorld) voxelWorld.disposeAll();
      if (pickups) pickups.clear();
      if (particles) particles.clear();
      if (creatures) creatures.clear();

      appState.activeWorld = record;
      appState.isDead = false;
      els.respawnModal.classList.add('hidden');
      els.inventoryModal.classList.add('hidden');

      voxelWorld = new VoxelWorld(record, scene, opaqueMaterial, transMaterial, graphicsSettings);
      pickups = new PickupEntityManager(scene, voxelWorld);
      if (!particles) particles = new BlockParticlePool(scene);
      creatures = new CreatureManager(scene, voxelWorld, pickups);

      timeOfDay = typeof record.timeOfDay === 'number' ? record.timeOfDay : 0.25;

      if (record.player && typeof record.player.x === 'number') {
        player.pos.set(record.player.x, record.player.y, record.player.z);
        player.yaw = record.player.yaw || 0;
        player.pitch = record.player.pitch || 0;
        player.hp = typeof record.player.hp === 'number' ? record.player.hp : 20;
        player.hunger = typeof record.player.hunger === 'number' ? record.player.hunger : 20;
        player.flying = record.mode === 'creative' ? Boolean(record.player.flying) : false;
      } else {
        const sy = voxelWorld.findSafeSpawnY(0, 0);
        player.pos.set(0, sy, 0);
        player.yaw = 0;
        player.pitch = 0;
        player.hp = 20;
        player.hunger = 20;
        player.flying = false;
      }
      player.vel.set(0, 0, 0);
      player.fallStartY = null;

      if (record.inventory && Array.isArray(record.hotbar)) {
        player.inventory = { ...record.inventory };
        player.hotbar = record.hotbar.slice(0, 9);
        while (player.hotbar.length < 9) player.hotbar.push(null);
      } else {
        initDefaultInventory(record.mode);
      }
      player.selectedSlot = 0;

      voxelWorld.updateStreaming(player.pos, 24);
      const pcx = Math.floor(player.pos.x / CHUNK_W);
      const pcz = Math.floor(player.pos.z / CHUNK_D);
      for (let dz = -2; dz <= 2; dz++) {
        for (let dx = -2; dx <= 2; dx++) {
          const ch = voxelWorld.getOrCreateChunk(pcx + dx, pcz + dz);
          if (ch.dirty) voxelWorld.buildChunkGeometry(ch);
        }
      }

      creatures.populateInitial(player.pos, isNightTime());
      updateSkyAndLighting(0);

      els.hudWorldName.textContent = record.name;
      els.hudModeBadge.textContent = record.mode.toUpperCase();
      els.hudModeBadge.className = `px-1.5 py-0.5 rounded text-[10px] uppercase border ${
        record.mode === 'creative'
          ? 'bg-sky-500/25 text-sky-300 border-sky-400/30'
          : 'bg-emerald-500/25 text-emerald-300 border-emerald-400/30'
      }`;

      renderHotbar();
      renderSurvivalMeters();
      setScreen('playing');
      requestCanvasPointerLock();
      showToast(`Entered "${record.name}" (${record.mode.toUpperCase()})`);
    }

